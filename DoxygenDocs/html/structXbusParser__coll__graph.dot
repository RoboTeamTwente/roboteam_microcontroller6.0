digraph "XbusParser"
{
 // INTERACTIVE_SVG=YES
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10,arrowhead=open, arrowtail=open, arrowsize=0.7];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="XbusParser",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Xbus Parser state structure."];
  Node2 -> Node1 [id="edge1_Node000001_Node000002",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" callbacks",fontcolor="grey" ];
  Node2 [id="Node000002",label="XbusParserCallback",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structXbusParserCallback.html",tooltip="Callback function structure for use with the XbusParser."];
  Node3 -> Node1 [id="edge2_Node000001_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" currentMessage",fontcolor="grey" ];
  Node3 [id="Node000003",label="XbusMessage",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structXbusMessage.html",tooltip="An Xbus message structure with optional payload."];
}
